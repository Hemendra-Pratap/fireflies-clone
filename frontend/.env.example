# Frontend Environment Configuration
# API Base URL (Relative path '/api/v1' for production Nginx proxying or full URL for Vite dev server)
VITE_API_BASE_URL=/api/v1

# CRITICAL SECURITY NOTE:
# NEVER put GEMINI_API_KEY, JWT_SECRET_KEY, GOOGLE_CLIENT_SECRET, or DATABASE_URL into frontend environment variables!
# Any variable starting with VITE_ is bundled into client-side JavaScript and exposed to the browser.
